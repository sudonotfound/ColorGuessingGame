<h1>色あてゲーム</h1>
<p>画面の色をRGBそれぞれの値で答えてください</p>
<p>これであなたも色彩マスター！</p>

<!-- 正解の色の表示 -->
<h3>この色は何色？</h3>
<div style="width: 100px; height: 100px; background-color: rgb(<%= @color[:r] %>, <%= @color[:g] %>, <%= @color[:b] %>); border: 2px solid black;"></div> 

<!-- 回答フォーム -->
<%= form_with url: check_answer_path, method: :post do %>
  <p>
    <label for="r">R:</label>
    <input type="number" id="r" name="r" value="<%= @r %>" min="0" max="255" />
  </p>
  <p>
    <label for="g">G:</label>
    <input type="number" id="g" name="g" value="<%= @g %>" min="0" max="255" />
  </p>
  <p>
    <label for="b">B:</label>
    <input type="number" id="b" name="b" value="<%= @b %>" min="0" max="255" />
  </p>
  <p>
    <%= submit_tag "回答" %>
  </p>
<% end %>

<!-- 判定結果の表示 -->
<% if @result %>
  <p><strong>判定結果:</strong> <%= @result %></p>
<% end %>

<!-- ユーザーの回答と正解の表示 -->
<% if @r && @g && @b %>
  <p>あなたの回答: R=<%= @r %>, G=<%= @g %>, B=<%= @b %></p>
  <p>正解の色: R=<%= @correct_color[:r] %>, G=<%= @correct_color[:g] %>, B=<%= @correct_color[:b] %></p>

  <!-- 色を視覚的に比較 -->
  <div style="display: flex; gap: 20px; margin-top: 20px;">
    <div>
      <p>あなたの色</p>
      <div style="width: 100px; height: 100px; background-color: rgb(<%= @r %>, <%= @g %>, <%= @b %>); border: 2px solid gray;"></div>
    </div>
    <div>
      <p>正解の色</p>
      <div style="width: 100px; height: 100px; background-color: rgb(<%= @correct_color[:r] %>, <%= @correct_color[:g] %>, <%= @correct_color[:b] %>); border: 2px solid black;"></div>
    </div>
  </div>
<% end %>
